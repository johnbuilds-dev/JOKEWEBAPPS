@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-5 mt-4">
            <h1 class="mb-4 font-weight-bold" style="color: var(--primary-accent);">@ViewData["Title"]</h1>

            <div class="card-text" style="font-size: 1.1rem; line-height: 1.8;">
                <p>Welcome to JOKEWEBAPPS!</p>
                <p>We take your privacy seriously. The only thing we want to share are laughs.</p>
                
                <h4 class="mt-4 mb-3" style="color: var(--text-primary);">Data Collection</h4>
                <p>We collect your username, email, and the jokes you post. We also track which jokes you upvote so we can show you a personalized experience.</p>
                
                <h4 class="mt-4 mb-3" style="color: var(--text-primary);">Cookies</h4>
                <p>We use standard authentication cookies to keep you logged in. Nothing sneaky.</p>
            </div>
        </div>
    </div>
</div>
