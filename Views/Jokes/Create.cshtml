@model JOKEWEBAPPS.Models.Joke

@{
    ViewData["Title"] = "Create Post";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4 text-center" style="color: var(--primary-accent); font-family: 'Quicksand', sans-serif;">Create a Post</h2>
            
            <!-- Tabs -->
            <ul class="nav nav-pills nav-fill mb-4 custom-tabs" id="createTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active font-weight-bold" id="joke-tab" data-toggle="tab" href="#classic-joke" role="tab" aria-controls="classic-joke" aria-selected="true">📝 Classic Joke</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link font-weight-bold" id="meme-tab" data-toggle="tab" href="#meme-builder" role="tab" aria-controls="meme-builder" aria-selected="false">🖼️ Meme / Reaction</a>
                </li>
            </ul>

            <div class="tab-content" id="createTabsContent">
                <!-- Classic Joke Tab -->
                <div class="tab-pane fade show active" id="classic-joke" role="tabpanel" aria-labelledby="joke-tab">
                    <div class="card shadow-sm border-0" style="background-color: var(--surface-color); border-radius: 20px;">
                        <div class="card-body p-5">
                            <form asp-action="Create">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-group mb-4">
                                    <label asp-for="JokeQuestion" class="control-label font-weight-bold" style="color: var(--text-primary);">Setup</label>
                                    <input asp-for="JokeQuestion" class="form-control form-control-lg" placeholder="Why did the chicken cross the road?" style="border-radius: 12px; background-color: #F8F9FA; border: none; padding: 15px;" />
                                    <span asp-validation-for="JokeQuestion" class="text-danger"></span>
                                </div>
                                <div class="form-group mb-4">
                                    <label asp-for="JokeAnswer" class="control-label font-weight-bold" style="color: var(--text-primary);">Punchline</label>
                                    <input asp-for="JokeAnswer" class="form-control form-control-lg" placeholder="To get to the other side!" style="border-radius: 12px; background-color: #F8F9FA; border: none; padding: 15px;" />
                                    <span asp-validation-for="JokeAnswer" class="text-danger"></span>
                                </div>
                                <div class="form-group text-center mt-5">
                                    <input type="submit" value="Drop the Mic 🎤" class="btn btn-primary btn-lg px-5" style="border-radius: 50px; font-weight: 700;" />
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Meme Builder Tab -->
                <div class="tab-pane fade" id="meme-builder" role="tabpanel" aria-labelledby="meme-tab">
                    <div class="card shadow-sm border-0" style="background-color: var(--surface-color); border-radius: 20px;">
                        <div class="card-body p-5">
                            <div class="form-group mb-4">
                                <label class="control-label font-weight-bold" style="color: var(--text-primary);">1. Write a Caption</label>
                                <textarea id="meme-caption" class="form-control" rows="2" placeholder="POV: When you finally fix the bug..." style="border-radius: 12px; background-color: #F8F9FA; border: none; padding: 15px; resize: none;"></textarea>
                            </div>
                            
                            <div class="form-group mb-4">
                                <label class="control-label font-weight-bold" style="color: var(--text-primary);">2. Upload a Reaction (Image/GIF)</label>
                                <div class="upload-area p-5 text-center" style="border: 2px dashed var(--secondary-accent); border-radius: 20px; background-color: rgba(78, 205, 196, 0.05); cursor: pointer; transition: all 0.3s ease;" onclick="document.getElementById('meme-image-upload').click()" onmouseover="this.style.backgroundColor='rgba(78, 205, 196, 0.15)'" onmouseout="this.style.backgroundColor='rgba(78, 205, 196, 0.05)'">
                                    <span style="font-size: 2.5rem;">📸</span>
                                    <p class="mt-3 mb-0" style="color: var(--secondary-accent); font-weight: 700; font-size: 1.1rem;">Click to upload</p>
                                    <p class="text-muted small">Supports JPG, PNG, GIF</p>
                                    <input type="file" id="meme-image-upload" accept="image/png, image/jpeg, image/gif" style="display: none;" onchange="previewMeme(event)" />
                                </div>
                            </div>
                            
                            <!-- Live Preview Area -->
                            <div id="meme-preview-container" class="mt-4 text-center d-none">
                                <label class="control-label font-weight-bold text-muted mb-3">Live Preview</label>
                                <div class="position-relative d-inline-block shadow-sm" style="border-radius: 12px; overflow: hidden; max-width: 100%; background-color: black;">
                                    <!-- The caption text overlay -->
                                    <div id="meme-preview-text" class="position-absolute w-100 text-center" style="top: 0; background-color: white; padding: 12px 15px; font-family: 'Arial', sans-serif; font-size: 20px; font-weight: bold; color: black; line-height: 1.3; display: none;"></div>
                                    <!-- The image -->
                                    <img id="meme-preview-img" src="#" alt="Meme Preview" style="max-width: 100%; display: block; max-height: 400px; object-fit: contain;" />
                                </div>
                            </div>

                            <div class="form-group text-center mt-5">
                                <button type="button" class="btn btn-lg px-5 text-white" style="border-radius: 50px; font-weight: 700; background-color: var(--secondary-accent); box-shadow: 0 4px 15px rgba(78, 205, 196, 0.4);" onclick="submitMeme()" onmouseover="this.style.transform='translateY(-2px)';" onmouseout="this.style.transform='translateY(0)';">Post Meme 🚀</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a asp-action="Index" class="text-muted font-weight-bold" style="text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary-accent)'" onmouseout="this.style.color='var(--text-muted)'">&larr; Back to Archives</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <style>
        .custom-tabs .nav-link {
            border-radius: 50px;
            color: var(--text-muted);
            margin: 0 10px;
            transition: all 0.3s ease;
            font-size: 1.1rem;
            padding: 12px 20px;
            background-color: var(--surface-color);
            box-shadow: var(--soft-shadow);
        }
        .custom-tabs .nav-link:hover {
            transform: translateY(-2px);
        }
        .custom-tabs .nav-link.active {
            background-color: var(--primary-accent);
            color: white !important;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.4);
        }
        [data-theme="dark"] .custom-tabs .nav-link {
            background-color: #1E293B;
            border-color: #334155;
        }
        [data-theme="dark"] .custom-tabs .nav-link.active {
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
        }
        [data-theme="dark"] .upload-area {
            background-color: rgba(0, 229, 255, 0.05) !important;
            border-color: rgba(0, 229, 255, 0.5) !important;
        }
        [data-theme="dark"] .upload-area:hover {
            background-color: rgba(0, 229, 255, 0.15) !important;
        }
        [data-theme="dark"] .upload-area p.text-muted {
            color: #94A3B8 !important;
        }
    </style>
    <script>
        const captionInput = document.getElementById('meme-caption');
        const previewText = document.getElementById('meme-preview-text');
        
        captionInput.addEventListener('input', (e) => {
            previewText.innerText = e.target.value;
            // hide/show text background based on if there's text
            if(e.target.value.trim().length > 0) {
                previewText.style.display = 'block';
            } else {
                previewText.style.display = 'none';
            }
        });

        function previewMeme(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('meme-preview-img').src = e.target.result;
                    document.getElementById('meme-preview-container').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        async function submitMeme() {
            const file = document.getElementById('meme-image-upload').files[0];
            const caption = document.getElementById('meme-caption').value;
            if (!file) {
                alert("Please select an image first!");
                return;
            }
            
            // Call the stub we added in site.js
            try {
                await saveMemeJoke(file, caption, 'top');
                alert("Meme posted successfully! (Check console for output)");
                window.location.href = '/Jokes';
            } catch (err) {
                console.error("Error saving meme", err);
            }
        }
    </script>
}
