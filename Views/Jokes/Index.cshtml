@model IEnumerable<JOKEWEBAPPS.Models.Joke>

@{
    ViewData["Title"] = "Archive";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h1 class="mb-0" style="color: var(--primary-accent); letter-spacing: -0.5px;">The Archives</h1>
        <p class="text-muted mt-2" style="font-size: 1.1rem;">A collection of past giggles and groans.</p>
    </div>
    <div class="col-md-6 text-md-right">
        <a asp-action="Create" class="btn btn-primary btn-lg">Add to Archive</a>
    </div>
</div>

<div class="row">
    @foreach (var item in Model) {
        <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
            <div class="card w-100 h-100">
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title font-weight-bold mb-3" style="color: var(--text-primary);">
                        @Html.DisplayFor(modelItem => item.JokeQuestion)
                    </h5>
                    <p class="card-text mb-4" style="color: var(--text-muted); font-size: 1.1rem; flex-grow: 1;">
                        @Html.DisplayFor(modelItem => item.JokeAnswer)
                    </p>
                    <div class="mt-auto d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid #F1F2F6;">
                        <div>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-muted mr-2" style="font-size: 0.9rem;">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-muted mr-2" style="font-size: 0.9rem;">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger" style="font-size: 0.9rem;">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
