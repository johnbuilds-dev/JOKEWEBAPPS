<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4">
            <div class="card-body text-center">
                <h1 class="card-title font-weight-bold mb-4" style="color: var(--primary-accent); letter-spacing: -0.5px;">Search Jokes</h1>
                <p class="text-muted mb-4" style="font-size: 1.1rem;">Looking for something specific? Type a keyword below.</p>
                <form asp-action="ShowSearchResults">
                    <div class="form-group mb-4">
                        <input name="SearchPhrase" class="form-control form-control-lg text-center" placeholder="e.g. chicken, programmer, pizza..." />
                    </div>
                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-primary btn-lg w-100">Find Jokes 🔍</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="text-center mt-4">
            <a asp-action="Index" class="text-muted" style="font-size: 1.1rem;">&larr; Back to List</a>
        </div>
    </div>
</div>
